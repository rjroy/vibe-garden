# Courier MCP Environment Variables
#
# Copy this file to .env and fill in the actual values.
# IMPORTANT: .env is in .gitignore - never commit it to version control!
#
# Required Variables:
# ==================
# GMAIL_CREDENTIALS_PATH - Path to credentials.json (OAuth credentials from Google Cloud)
#
# Optional Variables (uses defaults from courier.config if not set):
# ==================================================================

# Path to Gmail OAuth credentials JSON file
# Example: /home/user/.courier/credentials.json
# Setup instructions: See docs/SETUP.md
GMAIL_CREDENTIALS_PATH=

# Maximum timeout for any operation in seconds (default: 20)
# COURIER_TIMEOUT_SECONDS=20

# Default maximum results per request, 1-100 (default: 10)
# COURIER_MAX_RESULTS_DEFAULT=10

# Maximum markdown file size in KB (default: 10)
# Files exceeding this are truncated with a note
# COURIER_MAX_FILE_SIZE_KB=10

# Network retry configuration
# Number of retry attempts on transient failures (default: 3)
# COURIER_NETWORK_RETRY_ATTEMPTS=3

# Exponential backoff multiplier for retries, 2^attempt * factor (default: 2)
# COURIER_NETWORK_RETRY_BACKOFF_FACTOR=2

# Label cache TTL in seconds (default: 3600 = 1 hour)
# Set to 0 to disable caching
# COURIER_LABEL_CACHE_TTL_SECONDS=3600

# Log file path (relative or absolute, default: ./courier-mcp.log)
# COURIER_LOG_PATH=./courier-mcp.log

# Log level: DEBUG, INFO, WARNING, ERROR (default: DEBUG)
# COURIER_LOG_LEVEL=DEBUG
