# Courier MCP Configuration
#
# This file contains default configuration values for the Courier MCP server.
# Instance-specific overrides should be provided via environment variables.
#
# Environment Variable Naming Convention:
# COURIER_<SETTING_NAME> (e.g., COURIER_TIMEOUT_SECONDS, COURIER_MAX_RESULTS_DEFAULT)
#
# Example .env file:
#   COURIER_TIMEOUT_SECONDS=30
#   COURIER_MAX_RESULTS_DEFAULT=20
#   GMAIL_CREDENTIALS_PATH=/home/user/.courier/credentials.json

# Request timeout in seconds (maximum operation time)
# Environment override: COURIER_TIMEOUT_SECONDS
COURIER_TIMEOUT_SECONDS: 20

# Default maximum results per request (1-100)
# Environment override: COURIER_MAX_RESULTS_DEFAULT
COURIER_MAX_RESULTS_DEFAULT: 10

# Maximum markdown file size in KB (files exceeding this are truncated with note)
# Environment override: COURIER_MAX_FILE_SIZE_KB
COURIER_MAX_FILE_SIZE_KB: 10

# Network retry configuration (for transient failures)
# Applies to: connection timeouts, connection refused, temporary unavailable (503)
# Does NOT apply to: rate limits (429), auth failures (401, 403), invalid requests (400)

# Number of retry attempts on transient network failures
# Environment override: COURIER_NETWORK_RETRY_ATTEMPTS
COURIER_NETWORK_RETRY_ATTEMPTS: 3

# Exponential backoff multiplier (2^attempt * factor)
# Environment override: COURIER_NETWORK_RETRY_BACKOFF_FACTOR
COURIER_NETWORK_RETRY_BACKOFF_FACTOR: 2

# Label cache TTL in seconds (0 disables caching)
# Environment override: COURIER_LABEL_CACHE_TTL_SECONDS
COURIER_LABEL_CACHE_TTL_SECONDS: 3600

# Log file path (relative or absolute)
# Environment override: COURIER_LOG_PATH
COURIER_LOG_PATH: ./courier-mcp.log

# Log level (DEBUG, INFO, WARNING, ERROR)
# Environment override: COURIER_LOG_LEVEL
COURIER_LOG_LEVEL: DEBUG

# Gmail API quota per user (informational, read-only)
# - 250 quota units/second per user
# - labels.list(): 1 unit
# - messages.list(): ~1 unit
# - messages.get(): ~5 units
GMAIL_API_QUOTA_UNITS_PER_SECOND: 250
