    "data_source": "https://huggingface.co",
    "schema_version": "1.0",
    "notes": "Local image generation models compatible with diffusers library. All models are SD 1.5 based (~4GB VRAM at 512x512). Curated for specific use cases: general, anime, stylized art, character design, animation."
  },
  "models": [
    {
      "model": "stable-diffusion-v1-5/stable-diffusion-v1-5",
      "description": "Use for general-purpose local generation. Classic SD 1.5 baseline with good quality and low VRAM requirements. Best for photorealistic and general imagery.",
      "vram_requirement_gb": 4,
      "quality": 70,
      "speed": 60,
      "text_rendering": 30,
      "use_case": "general",
      "trigger_words": null,
      "notes": "Baseline model. Trained on 512x512 resolution. Use 50 inference steps for best quality."
    },
    {
      "model": "hakurei/waifu-diffusion",
      "description": "Use for anime and illustration-style images. Fine-tuned on high-quality anime images. Best for character art, anime scenes, and stylized illustrations.",
      "vram_requirement_gb": 4,
      "quality": 75,
      "speed": 60,
      "text_rendering": 20,
      "use_case": "anime",
      "trigger_words": null,
      "notes": "Supports danbooru tags (1girl, white hair, etc). Uses guidance_scale=6 by default."
    },
    {
      "model": "prompthero/openjourney",
      "description": "Use for stylized artistic images mimicking Midjourney aesthetic. Excellent for fantasy, surreal, and highly stylized artwork with rich colors and dramatic lighting.",
      "vram_requirement_gb": 4,
      "quality": 80,
      "speed": 60,
      "text_rendering": 25,
      "use_case": "stylized_art",
      "trigger_words": "mdjrny-v4 style",
      "notes": "Include 'mdjrny-v4 style' in prompt for best results. Very popular model (16K+ downloads/month)."
    },
    {
      "model": "nitrosocke/Arcane-Diffusion",
      "description": "Use for character design in the style of Netflix's Arcane series. Excellent for portraits, character concepts, and stylized figures with painterly detail.",
      "vram_requirement_gb": 4,
      "quality": 82,
      "speed": 60,
      "text_rendering": 20,
      "use_case": "character_design",
      "trigger_words": "arcane style",
      "notes": "Include 'arcane style' in prompt. Trained on 95 images from the show. Great for character portraits."
    },
    {
      "model": "nitrosocke/mo-di-diffusion",
      "description": "Use for modern Disney/Pixar animation style. Excellent for animated characters, animals, vehicles, and landscapes with that polished animation studio look.",
      "vram_requirement_gb": 4,
      "quality": 80,
      "speed": 60,
      "text_rendering": 20,
      "use_case": "animation",
      "trigger_words": "modern disney style",
      "notes": "Include 'modern disney style' in prompt. Trained via DreamBooth on animation studio screenshots."
    }
  ],
